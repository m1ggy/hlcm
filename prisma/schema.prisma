// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum ApplicationStatus {
  DRAFT
  INFO_GATHERING
  SUBMITTED
  UNDER_AGENCY_REVIEW
  NEEDS_REVISION
  APPROVED
  DENIED
  CLOSED
}

// Which stage list an Application/McoCredential moves through. Home Care
// covers IDPH/IDoA/IDHS/Other (the Agency field distinguishes those); CILA
// covers CILA and other group-home licensing; MCO is payer credentialing.
enum Pipeline {
  HOME_CARE
  CILA_GROUP_HOME
  MCO
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  NA
  CLOSED
}

// Which agency a Home Care case is filed with. Meaningful mainly for the
// HOME_CARE pipeline (see docs/pipeline-stage-plan.md) — nullable everywhere
// else.
enum Agency {
  IDPH
  IDOA
  IDHS
  OTHER
}

// Whose court the ball is in right now — a quick glance answer to "who are
// we waiting on".
enum BallWith {
  CTK
  CLIENT
  GOVERNMENT
}

enum McoName {
  AETNA
  BCBS_IL
  COUNTY_CARE
  HUMANA
  MERIDIAN
  MOLINA
  OTHER
}

enum GrantPermission {
  VIEW
  EDIT
}

enum FieldSource {
  AUTO
  CUSTOM
}

enum GeneratedDocumentStatus {
  DRAFT
  APPROVED
  SENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_REVIEW_REQUESTED
  TASK_STATUS_CHANGED
  APPLICATION_STATUS_CHANGED
  APPLICATION_SHARED
  MENTIONED
  INVOICE_PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  mfaSecret    String?
  mfaEnabled   Boolean  @default(false)
  active       Boolean  @default(true)
  hourlyRate   Float?
  emailNotificationsEnabled Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectsCreated              Project[]                @relation("ProjectCreatedBy")
  clientsCreated                Client[]                @relation("ClientCreatedBy")
  applicationsOwned             Application[]            @relation("ApplicationOwner")
  applicationsManaging          Application[]            @relation("ApplicationManager")
  mcoCredentialsAssigned        McoCredential[]          @relation("McoCredentialAssignee")
  mcoCredentialsManaging        McoCredential[]          @relation("McoCredentialManager")
  mcoCredentialsCreated         McoCredential[]          @relation("McoCredentialCreatedBy")
  applicationsCreated           Application[]            @relation("ApplicationCreatedBy")
  licenseTypeTemplatesCreated   LicenseTypeTemplate[]    @relation("LicenseTypeTemplateCreatedBy")
  caseTypesCreated               CaseType[]               @relation("CaseTypeCreatedBy")
  pipelineStagesCreated           PipelineStage[]          @relation("PipelineStageCreatedBy")
  serviceTypesCreated              ServiceType[]            @relation("ServiceTypeCreatedBy")
  clientCredentialsCreated         ClientCredential[]       @relation("ClientCredentialCreatedBy")
  stageHistoryActed               StageHistory[]           @relation("StageHistoryActor")
  checklistItemTemplatesCreated ChecklistItemTemplate[]  @relation("ChecklistItemTemplateCreatedBy")
  taskAssignments                 TaskAssignee[]
  taskReviews                     TaskReviewer[]
  tasksCreated                    Task[]                   @relation("TaskCreatedBy")
  auditLogs                       AuditLog[]
  accessGrantsReceived            AccessGrant[]            @relation("AccessGrantUser")
  accessGrantsGiven               AccessGrant[]            @relation("AccessGrantGrantedBy")
  filesUploaded                   FileAsset[]              @relation("FileUploadedBy")
  fileVersionsUploaded             FileVersion[]            @relation("FileVersionUploadedBy")
  documentTemplatesCreated         DocumentTemplate[]       @relation("DocumentTemplateCreatedBy")
  documentsGenerated               GeneratedDocument[]      @relation("GeneratedDocumentGeneratedBy")
  signatureProfile                 SignatureProfile?
  signatureEvents                  SignatureEvent[]         @relation("SignatureEventSignedBy")
  notifications                    Notification[]
  notesAuthored                    Note[]                   @relation("NoteAuthor")
  timeEntries                      TimeEntry[]
  wiseRecipient                    WiseRecipient?
  wisePayoutsReceived              WiseTransaction[]        @relation("WiseTransactionPayee")
  wisePayoutsInitiated             WiseTransaction[]        @relation("WiseTransactionInitiatedBy")
  invoicesCreated                  Invoice[]                @relation("InvoiceCreatedBy")

  @@map("users")
}

// A user's saved Wise payout account. `fields` holds whatever Wise's
// dynamic /account-requirements schema asked for that currency (routing +
// account number for USD, IFSC for INR, IBAN for PKR, etc.) — we don't
// hardcode a field set per country since Wise's own requirements are the
// source of truth and shift over time. `wiseAccountId` is the recipient
// account id Wise returned when we registered it; transfers are created
// against that id, not the raw fields, so this stays a thin cache.
model WiseRecipient {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  currency          String
  accountHolderName String
  legalType         String
  wiseAccountId     String
  fields            Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("wise_recipients")
}

// One row per payout attempt through Wise — kept even when a transfer fails
// partway (status reflects how far it got) so a re-pay attempt for the same
// period is a deliberate admin action, not something that silently double-pays.
model WiseTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("WiseTransactionPayee", fields: [userId], references: [id])
  initiatedById   String
  initiatedBy     User     @relation("WiseTransactionInitiatedBy", fields: [initiatedById], references: [id])
  periodFrom      DateTime
  periodTo        DateTime
  hours           Float
  sourceCurrency  String
  sourceAmount    Float
  targetCurrency  String
  targetAmount    Float
  wiseQuoteId     String
  wiseTransferId  String?
  status          String
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("wise_transactions")
}

// One row per clock-in/clock-out session. `clockOut` stays null while the
// user is on the clock — that's how we find "currently active" sessions and
// how we stop a second clock-in from stacking on top of an open one.
model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  clockIn   DateTime
  clockOut  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, clockIn])
  @@map("time_entries")
}

// A Project is an internal engagement/case grouping — independent of which
// company owns the client facilities inside it (e.g. a batch of renewals
// being worked together), not a customer account.
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdBy   User     @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Fills the project tag pill on the Clients list (docs/pipeline-stage-plan.md).
  // Nullable — unmapped projects fall back to a neutral default in the UI
  // rather than a hardcoded color per project.
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId String?

  clients Client[]

  @@map("projects")
}

// Admin-managed lookup for the Clients-list project pill color (same pattern
// as LicenseTypeTemplate/CaseType). `textColor` pairs with `hex` since some
// service colors need dark text (Ace Home Care Franchise's yellow) and
// others need white — never assumed from the background alone.
model ServiceType {
  id          String   @id @default(cuid())
  name        String   @unique
  hex         String
  textColor   String
  active      Boolean  @default(true)
  createdBy   User     @relation("ServiceTypeCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@map("service_types")
}

model Client {
  id          String   @id @default(cuid())
  // A client can be worked under more than one project (e.g. a facility
  // that comes back for a new batch of renewals next year) — many-to-many
  // rather than a single owning project, so it's added once and linked
  // wherever it's relevant instead of duplicated.
  projects    Project[]
  name        String
  contactInfo String?
  address     String?
  active      Boolean  @default(true)

  // Business details — the licensed entity itself.
  businessName  String?
  businessPhone String?
  businessEmail String?

  // Owner details — the individual who owns/operates the business. DOB
  // matters here (not on the business) since licensing bodies run
  // background checks against the owner, not the entity.
  ownerName        String?
  ownerEmail       String?
  ownerPhone       String?
  ownerDateOfBirth DateTime?

  // Structured billing address — separate from the freeform `address`
  // above because Stripe Tax needs discrete fields (state/postal code at
  // minimum for US nexus) to determine the tax jurisdiction on an invoice.
  // Required before sending an invoice with automatic tax (see
  // sendInvoice in src/lib/actions/invoices.ts).
  billingAddressLine1 String?
  billingCity         String?
  billingState        String?
  billingPostalCode   String?
  billingCountry      String? @default("US")

  // Cached Stripe Customer id (see src/lib/stripe.ts) — created on first
  // invoice send, reused after.
  stripeCustomerId String?

  createdBy   User     @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications    Application[]
  notes           Note[]
  mcoCredentials  McoCredential[]
  credentials     ClientCredential[]
  invoices        Invoice[]

  @@map("clients")
}

// What kind of license this Application is for (CILA, IDPH, IDOA, ...).
// Optional on Application — some Case Types (Change of Ownership) aren't
// tied to a license type at all.
model LicenseTypeTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdBy   User     @relation("LicenseTypeTemplateCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications            Application[]
  checklistItemTemplates  ChecklistItemTemplate[]
  documentTemplates       DocumentTemplate[]

  @@map("license_type_templates")
}

// What kind of case this is (New, Renewal, Post-License/Ongoing, Change of
// Ownership, ...) — orthogonal to license type, drives which checklist
// template applies.
model CaseType {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdBy   User     @relation("CaseTypeCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications            Application[]
  checklistItemTemplates  ChecklistItemTemplate[]

  @@map("case_types")
}

// A required checklist step for a given (LicenseTypeTemplate, CaseType)
// combo. Cloned into real Task rows when an Application is created with a
// matching combo. `phaseName` groups items into a Phase — leave null for
// flat/simple checklists (the common case).
model ChecklistItemTemplate {
  id                    String               @id @default(cuid())
  licenseTypeTemplate   LicenseTypeTemplate? @relation(fields: [licenseTypeTemplateId], references: [id])
  licenseTypeTemplateId String?
  caseType              CaseType             @relation(fields: [caseTypeId], references: [id])
  caseTypeId            String
  label                 String
  description           String?
  defaultRole           Role?
  phaseName             String?
  sortOrder             Int                  @default(0)
  createdBy             User                 @relation("ChecklistItemTemplateCreatedBy", fields: [createdById], references: [id])
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("checklist_item_templates")
}

// One stage in a pipeline's ordered stage list (see docs/pipeline-stage-plan.md).
// `sortOrder` — not `abbrev` — drives display order everywhere; abbreviations
// are unique only within a pipeline and would sort alphabetically on their
// own, scrambling the real process sequence.
// `isExitStatus` stages (On Hold, Withdrawn, Hearing Lost) are reachable from
// any other stage in the same pipeline, bypassing the forward-only rule.
// `allowedBackwardStageIds` is the explicit whitelist of stage ids this stage
// may move backward to (e.g. Corrections Received -> Submitted) — every other
// backward move is rejected. Names are locked after launch; renaming an
// existing row (rather than adding a new one) orphans historical records, so
// treat edits here as an admin-gated action, not a free-form CRUD form.
model PipelineStage {
  id                      String   @id @default(cuid())
  pipeline                Pipeline
  abbrev                  String
  name                    String
  sortOrder               Int
  hex                     String
  colorLabel              String
  isExitStatus            Boolean  @default(false)
  requiresReason          Boolean  @default(false)
  requiresFollowUpDate    Boolean  @default(false)
  allowedBackwardStageIds String[] @default([])
  active                  Boolean  @default(true)
  createdBy               User     @relation("PipelineStageCreatedBy", fields: [createdById], references: [id])
  createdById             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  applications    Application[]
  mcoCredentials  McoCredential[]
  stageHistory    StageHistory[]

  @@unique([pipeline, abbrev])
  @@index([pipeline, sortOrder])
  @@map("pipeline_stages")
}

// Phase 1 scope: bare case record. Phase 2 adds license/case type +
// checklist clone-on-create — those two FKs stay optional so existing
// Applications created before this migration keep working unchanged.
model Application {
  id          String            @id @default(cuid())
  client      Client            @relation(fields: [clientId], references: [id])
  clientId    String
  name        String
  description String?
  // Superseded by pipeline/stageId (docs/pipeline-stage-plan.md) — kept
  // read-only for one release after the backfill so nothing that still
  // references it breaks mid-rollout, then dropped.
  status      ApplicationStatus @default(DRAFT)
  active      Boolean           @default(true)

  // Which stage list this case moves through and where it currently sits.
  // Nullable until the backfill script runs; required after.
  pipeline   Pipeline?
  stage      PipelineStage? @relation(fields: [stageId], references: [id])
  stageId    String?

  licenseTypeTemplate   LicenseTypeTemplate? @relation(fields: [licenseTypeTemplateId], references: [id])
  licenseTypeTemplateId String?
  caseType              CaseType?            @relation(fields: [caseTypeId], references: [id])
  caseTypeId            String?

  // "Assigned VA" in the UI — the field/relation name predates the pipeline
  // spec's terminology, left as-is rather than churning every call site for
  // a label change.
  assignedUser   User   @relation("ApplicationOwner", fields: [assignedUserId], references: [id])
  assignedUserId String
  assignedManager   User?   @relation("ApplicationManager", fields: [assignedManagerId], references: [id])
  assignedManagerId String?

  // Case-tracking fields from docs/pipeline-stage-plan.md — all optional,
  // meaningful mainly for cases actively moving through a pipeline.
  agency                          Agency?
  ballIsWith                      BallWith?
  correctionRound                 Int?
  deficiencyReceivedDate          DateTime?
  deficiencyResponseDueDate       DateTime?
  deficiencyResponseSubmittedDate DateTime?

  createdBy   User     @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases            Phase[]
  tasks             Task[]
  accessGrants      AccessGrant[]
  files             FileAsset[]
  generatedDocuments GeneratedDocument[]
  notes             Note[]
  stageHistory      StageHistory[]
  invoices          Invoice[]

  @@map("applications")
}

// One row per stage change on an Application — the source of truth for
// "days in current stage" (now - latest row's enteredAt) and per-stage
// duration reporting. Never updated or deleted, only appended to, so history
// never shrinks even as a case moves back and forth.
// Polymorphic the same way Note is (exactly one of applicationId/
// mcoCredentialId set) — an MCO credential moves through the MCO pipeline
// independently of any Application, but needs the exact same "timestamp
// every stage change" history for its own days-in-stage/aging alerts.
model StageHistory {
  id              String         @id @default(cuid())
  application     Application?   @relation(fields: [applicationId], references: [id])
  applicationId   String?
  mcoCredential   McoCredential? @relation(fields: [mcoCredentialId], references: [id])
  mcoCredentialId String?
  stage           PipelineStage  @relation(fields: [stageId], references: [id])
  stageId         String
  // Set when the stage entered requires them (On Hold needs both, Withdrawn
  // needs reason) — belongs to this specific transition, not the case as a
  // whole, so it lives here rather than on Application/McoCredential.
  reason          String?
  followUpDate    DateTime?
  enteredAt       DateTime       @default(now())
  actor           User           @relation("StageHistoryActor", fields: [actorId], references: [id])
  actorId         String

  @@index([applicationId, enteredAt])
  @@index([mcoCredentialId, enteredAt])
  @@map("stage_history")
}

// One row per client per MCO — never one per client (a client credentialing
// with five MCOs has five records, each moving through the MCO pipeline
// independently). Client profile renders these side by side.
model McoCredential {
  id       String  @id @default(cuid())
  client   Client  @relation(fields: [clientId], references: [id])
  clientId String
  mcoName  McoName

  stage   PipelineStage? @relation(fields: [stageId], references: [id])
  stageId String?

  npi                    String?
  providerId             String?
  effectiveDate          DateTime?
  recredentialingDueDate DateTime?

  ballIsWith                       BallWith?
  correctionRound                  Int?
  deficiencyReceivedDate           DateTime?
  deficiencyResponseDueDate        DateTime?
  deficiencyResponseSubmittedDate  DateTime?

  assignedUser      User?   @relation("McoCredentialAssignee", fields: [assignedUserId], references: [id])
  assignedUserId     String?
  assignedManager    User?   @relation("McoCredentialManager", fields: [assignedManagerId], references: [id])
  assignedManagerId  String?

  createdBy   User     @relation("McoCredentialCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stageHistory StageHistory[]

  @@unique([clientId, mcoName])
  @@map("mco_credentials")
}

// Shares an Application with a user beyond its owner/assignee — e.g. a
// colleague covering while the owner is out, or (Phase 5) a Client portal
// user. VIEW sees the case; EDIT can also change tasks/properties/files.
model AccessGrant {
  id            String          @id @default(cuid())
  application   Application     @relation(fields: [applicationId], references: [id])
  applicationId String
  user          User            @relation("AccessGrantUser", fields: [userId], references: [id])
  userId        String
  permission    GrantPermission @default(VIEW)
  grantedBy     User            @relation("AccessGrantGrantedBy", fields: [grantedById], references: [id])
  grantedById   String
  createdAt     DateTime        @default(now())

  @@unique([applicationId, userId])
  @@map("access_grants")
}

// Two pools: the shared Application pool (applicationId set, taskId null —
// every user with case access sees these) and per-task attachments (taskId
// set, scoped to that one task/subtask, including standalone tasks where
// applicationId is null).
// fileName/mimeType/sizeBytes mirror the latest FileVersion so list queries
// don't need to join versions just to show current metadata.
model FileAsset {
  id            String       @id @default(cuid())
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  task          Task?        @relation(fields: [taskId], references: [id])
  taskId        String?
  fileName      String
  storageKey    String
  mimeType      String
  sizeBytes     Int
  uploadedBy    User         @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  uploadedById  String
  createdAt     DateTime     @default(now())

  versions        FileVersion[]
  signatureEvents SignatureEvent[]

  @@map("file_assets")
}

// One GCS generation of a FileAsset's object (same storageKey, overwritten
// in place — the bucket has Object Versioning on, so every generation is
// still retrievable). Uploading a new version or reverting both append a
// new row here rather than deleting anything, so history never shrinks.
// Files with any SignatureEvent are excluded from new versions/reverts
// (see assertNotSigned in files.ts) — a signed PDF's bytes must stay fixed.
model FileVersion {
  id           String   @id @default(cuid())
  fileAsset    FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  fileAssetId  String
  version      Int
  generation   BigInt
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedBy   User     @relation("FileVersionUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())

  @@unique([fileAssetId, version])
  @@map("file_versions")
}

// An uploaded merge-tag .docx (handbook, policy, etc.) admins manage. Scoped
// to a license type when it only applies to that kind of case; null means it
// shows up as an option for every Application.
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  licenseTypeTemplate   LicenseTypeTemplate? @relation(fields: [licenseTypeTemplateId], references: [id])
  licenseTypeTemplateId String?
  storageKey  String
  fileName    String
  active      Boolean  @default(true)
  createdBy   User     @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields             DocumentTemplateField[]
  generatedDocuments GeneratedDocument[]

  @@map("document_templates")
}

// One merge tag found in the template's .docx body. AUTO fields resolve from
// Client/Application data at generation time (see src/lib/merge-fields.ts for
// the fixed registry); CUSTOM fields prompt the VA for a value per generation.
model DocumentTemplateField {
  id         String      @id @default(cuid())
  template   DocumentTemplate @relation(fields: [templateId], references: [id])
  templateId String
  key        String
  label      String
  source     FieldSource @default(CUSTOM)
  autoField  String?
  sortOrder  Int         @default(0)

  @@unique([templateId, key])
  @@map("document_template_fields")
}

// One merged-and-generated document for an Application. `fieldValues` is a
// snapshot of the values used at generation time, kept for audit/reference —
// regenerating creates a new row rather than overwriting this one.
model GeneratedDocument {
  id            String                  @id @default(cuid())
  template      DocumentTemplate        @relation(fields: [templateId], references: [id])
  templateId    String
  application   Application             @relation(fields: [applicationId], references: [id])
  applicationId String
  fileName      String
  storageKey    String
  status        GeneratedDocumentStatus @default(DRAFT)
  fieldValues   Json
  generatedBy   User                    @relation("GeneratedDocumentGeneratedBy", fields: [generatedById], references: [id])
  generatedById String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("generated_documents")
}

// Optional ordered grouping of Tasks within an Application (e.g. "Phase 1",
// "Phase 2" for CILA post-license). Most Applications have none — Tasks with
// no Phase just render as a flat list.
model Phase {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  name          String
  sortOrder     Int         @default(0)

  tasks Task[]

  @@map("phases")
}

// A checklist item / task. `applicationId` is null for standalone/recurring
// ops tasks not tied to any case. `parentTaskId` set = this is a subtask.
model Task {
  id            String   @id @default(cuid())
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  phase         Phase?       @relation(fields: [phaseId], references: [id])
  phaseId       String?

  checklistItemTemplateId String?

  label       String
  description String?
  status      TaskStatus @default(NOT_STARTED)
  sortOrder   Int        @default(0)

  dueDate         DateTime?
  blockedReason   String?
  recurrenceRule  String?
  archived        Boolean  @default(false)

  assignees TaskAssignee[]
  reviewers TaskReviewer[]

  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  parentTaskId String?
  subtasks     Task[]  @relation("TaskSubtasks")

  createdBy   User     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes Note[]
  files FileAsset[]

  @@map("tasks")
}

model TaskAssignee {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([taskId, userId])
  @@map("task_assignees")
}

model TaskReviewer {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([taskId, userId])
  @@map("task_reviewers")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String?
  oldValue   String?
  newValue   String?
  action     String
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// User's saved signature image, drawn/typed/uploaded once and reused across
// documents — applying it to a specific document is still an explicit
// per-signing action (SignatureEvent), so accountability stays per-event.
model SignatureProfile {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String   @unique
  signatureImageKey String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("signature_profiles")
}

// A signature flattened onto a specific FileAsset (the resulting signed PDF).
// Position stored as ratios of page size so it's independent of any one
// viewer's pixel scale.
model SignatureEvent {
  id          String   @id @default(cuid())
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id])
  fileAssetId String
  signedBy    User     @relation("SignatureEventSignedBy", fields: [signedById], references: [id])
  signedById  String
  pageNumber  Int
  xRatio      Float
  yRatio      Float
  widthRatio  Float
  heightRatio Float
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("signature_events")
}

// In-app notification for events a user should know about (reassignment,
// review requests, status changes, new access grants). Pull-based — no
// background scheduler in this deployment, so everything is created inline
// by the action that causes it.
model Notification {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id])
  userId     String
  type       NotificationType
  message    String
  entityType String
  entityId   String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// Comment thread on an Application — the collaboration surface for staff
// discussing a case. @mentions are resolved client-side into explicit user
// ids (not parsed from text server-side) so notification delivery never
// depends on exact name matching.
// Exactly one of applicationId/taskId/clientId is set — Application
// comments are the case-level discussion thread, Task comments are notes on
// one checklist item or standalone task, Client comments are general notes
// on that client (not tied to any one case).
model Note {
  id            String       @id @default(cuid())
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  task          Task?        @relation(fields: [taskId], references: [id])
  taskId        String?
  client        Client?      @relation(fields: [clientId], references: [id])
  clientId      String?
  body          String
  author        User         @relation("NoteAuthor", fields: [authorId], references: [id])
  authorId      String
  createdAt     DateTime     @default(now())

  @@map("notes")
}

// Portal/agency login credentials for a client, kept as their own structured
// section rather than typed into the Notes thread — the whole point being
// they don't get buried under a growing comment feed (per the spec: "so
// that when the manager or VA adds notes, the login credentials ... will
// not get buried or overlooked"). Stored as plain fields, same visibility
// as the rest of a Client record — not encrypted at rest.
model ClientCredential {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  label       String
  username    String?
  password    String?
  url         String?
  notes       String?
  createdBy   User     @relation("ClientCredentialCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_credentials")
}

// One invoice sent to a Client, optionally tied back to the Application it
// was billed for. `seq` is a plain autoincrement used only to render a
// stable display number ("INV-00042") — there's no separate unique string
// column to keep in sync or race on. `total` is always server-recomputed
// from lineItems + taxAmount, never trusted from the client.
model Invoice {
  id            String        @id @default(cuid())
  // Local draft counter — only used to display a number before Stripe
  // assigns its own (stripeInvoiceNumber, set at finalize).
  seq           Int           @default(autoincrement())
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  application   Application?  @relation(fields: [applicationId], references: [id])
  applicationId String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?

  // Null until Stripe finalizes the invoice — Stripe computes the actual
  // tax (via Stripe Tax) and total at that point, not us.
  total     Float?
  taxAmount Float?

  // Set on first "Send": a Stripe Invoice + its line items are created,
  // finalized, then emailed by Stripe itself (see src/lib/stripe.ts /
  // src/lib/actions/invoices.ts). Resending reuses the same Stripe invoice.
  stripeInvoiceId     String? @unique
  stripeInvoiceNumber String?
  hostedInvoiceUrl    String?
  invoicePdfUrl       String?

  sentAt      DateTime?
  paidAt      DateTime?
  createdBy   User      @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lineItems InvoiceLineItem[]

  @@index([clientId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  sortOrder   Int     @default(0)

  @@map("invoice_line_items")
}
