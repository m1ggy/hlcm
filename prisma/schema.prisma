// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// DEVELOPER is a break-glass superuser, same reach as OWNER — it exists
// only to bootstrap the first OWNER (or fix a locked-out account) without
// touching the database by hand every time. It's deliberately NOT
// assignable through the app (see ROLE_VALUES in src/lib/actions/users.ts)
// — the only way to create or edit a DEVELOPER account is direct SQL.
//
// OWNER sits above ADMIN — same access everywhere ADMIN has it, plus
// exclusive rights to create/edit/demote other ADMIN/ACCOUNTANT/OWNER
// accounts. ACCOUNTANT carries every ADMIN permission too, plus exclusive
// access to Invoices that plain ADMIN doesn't get (see
// requireRole()/isAdmin()/canAccessInvoices() in src/lib/rbac.ts).
enum Role {
  DEVELOPER
  OWNER
  ADMIN
  ACCOUNTANT
  MANAGER
  STAFF
  CLIENT
  CAREGIVER
}

enum ApplicationStatus {
  DRAFT
  INFO_GATHERING
  SUBMITTED
  UNDER_AGENCY_REVIEW
  NEEDS_REVISION
  APPROVED
  DENIED
  CLOSED
}

// Which stage list an Application/McoCredential moves through. Home Care
// covers IDPH/IDoA/IDHS/Other (the Agency field distinguishes those); CILA
// covers CILA and other group-home licensing; MCO is payer credentialing.
enum Pipeline {
  HOME_CARE
  CILA_GROUP_HOME
  MCO
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  NA
  CLOSED
}

// Which agency a Home Care case is filed with. Meaningful mainly for the
// HOME_CARE pipeline (see docs/pipeline-stage-plan.md) — nullable everywhere
// else.
enum Agency {
  IDPH
  IDOA
  IDHS
  OTHER
}

// Whose court the ball is in right now — a quick glance answer to "who are
// we waiting on".
enum BallWith {
  CTK
  CLIENT
  GOVERNMENT
}

enum McoName {
  AETNA
  BCBS_IL
  COUNTY_CARE
  HUMANA
  MERIDIAN
  MOLINA
  OTHER
}

enum GrantPermission {
  VIEW
  EDIT
}

enum FieldSource {
  AUTO
  CUSTOM
}

enum GeneratedDocumentStatus {
  DRAFT
  APPROVED
  SENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_REVIEW_REQUESTED
  TASK_STATUS_CHANGED
  APPLICATION_STATUS_CHANGED
  APPLICATION_SHARED
  MENTIONED
  INVOICE_PAID
  LEAD_BOOKED
  LEAD_CANCELED
  MEETING_REMINDER
  ENVELOPE_COMPLETED
  ENVELOPE_DECLINED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  // Manually-recorded invoices only (see recordManualPayment /
  // addManualPayment in src/lib/actions/invoices.ts) — a Stripe-bound
  // invoice only ever reaches PAID in one webhook-driven step, never this.
  PARTIALLY_PAID
  OVERDUE
  VOID
}

model User {
  id                        String   @id @default(cuid())
  name                      String
  email                     String   @unique
  passwordHash              String
  role                      Role     @default(STAFF)
  mfaSecret                 String?
  mfaEnabled                Boolean  @default(false)
  active                    Boolean  @default(true)
  hourlyRate                Float?
  emailNotificationsEnabled Boolean  @default(true)
  // IANA zone id (e.g. "America/Chicago") — null means "use the browser's
  // own timezone" (the pre-existing behavior). Set from Account settings;
  // controls both how this user's own times are displayed and how a typed
  // time in a time-entry dialog is resolved to an instant, wherever this
  // user is the one reading/typing it (see src/lib/time-entries.ts).
  timezone                  String?
  // Admin-set (Admin > Users), not self-service like emailNotificationsEnabled
  // above — phone is only meaningful once smsRemindersEnabled is on. Off by
  // default: this is a small opt-in roster ("who gets a text/call for every
  // upcoming meeting"), not a per-user preference everyone starts with.
  phone                     String?
  smsRemindersEnabled       Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  projectsCreated               Project[]                 @relation("ProjectCreatedBy")
  clientsCreated                Client[]                  @relation("ClientCreatedBy")
  applicationsOwned             Application[]             @relation("ApplicationOwner")
  applicationsManaging          Application[]             @relation("ApplicationManager")
  mcoCredentialsAssigned        McoCredential[]           @relation("McoCredentialAssignee")
  mcoCredentialsManaging        McoCredential[]           @relation("McoCredentialManager")
  mcoCredentialsCreated         McoCredential[]           @relation("McoCredentialCreatedBy")
  applicationsCreated           Application[]             @relation("ApplicationCreatedBy")
  licenseTypeTemplatesCreated   LicenseTypeTemplate[]     @relation("LicenseTypeTemplateCreatedBy")
  caseTypesCreated              CaseType[]                @relation("CaseTypeCreatedBy")
  pipelineStagesCreated         PipelineStage[]           @relation("PipelineStageCreatedBy")
  serviceTypesCreated           ServiceType[]             @relation("ServiceTypeCreatedBy")
  clientCredentialsCreated      ClientCredential[]        @relation("ClientCredentialCreatedBy")
  stageHistoryActed             StageHistory[]            @relation("StageHistoryActor")
  checklistItemTemplatesCreated ChecklistItemTemplate[]   @relation("ChecklistItemTemplateCreatedBy")
  taskAssignments               TaskAssignee[]
  taskReviews                   TaskReviewer[]
  tasksCreated                  Task[]                    @relation("TaskCreatedBy")
  auditLogs                     AuditLog[]
  accessGrantsReceived          AccessGrant[]             @relation("AccessGrantUser")
  accessGrantsGiven             AccessGrant[]             @relation("AccessGrantGrantedBy")
  filesUploaded                 FileAsset[]               @relation("FileUploadedBy")
  fileVersionsUploaded          FileVersion[]             @relation("FileVersionUploadedBy")
  invoiceAttachmentsUploaded    InvoiceAttachment[]       @relation("InvoiceAttachmentUploadedBy")
  documentTemplatesCreated      DocumentTemplate[]        @relation("DocumentTemplateCreatedBy")
  documentsGenerated            GeneratedDocument[]       @relation("GeneratedDocumentGeneratedBy")
  signatureProfile              SignatureProfile?
  signatureEvents               SignatureEvent[]          @relation("SignatureEventSignedBy")
  notifications                 Notification[]
  notesAuthored                 Note[]                    @relation("NoteAuthor")
  timeEntries                   TimeEntry[]
  breakEntries                  BreakEntry[]
  taskTimeEntries               TaskTimeEntry[]
  wiseRecipient                 WiseRecipient?
  wisePayoutsReceived           WiseTransaction[]         @relation("WiseTransactionPayee")
  wisePayoutsInitiated          WiseTransaction[]         @relation("WiseTransactionInitiatedBy")
  invoicesCreated               Invoice[]                 @relation("InvoiceCreatedBy")
  paymentsRecorded              Payment[]                 @relation("PaymentRecordedBy")
  clientGroupsCreated           ClientGroup[]             @relation("ClientGroupCreatedBy")
  breakDeductionsFor            TimesheetBreakDeduction[] @relation("TimesheetBreakDeductionUser")
  breakDeductionsCreated        TimesheetBreakDeduction[] @relation("TimesheetBreakDeductionCreatedBy")
  formTemplatesCreated          FormTemplate[]            @relation("FormTemplateCreatedBy")
  formSubmissionsReviewed       FormSubmission[]          @relation("FormSubmissionReviewedBy")
  leadsReviewed                 Lead[]                    @relation("LeadReviewedBy")
  leadsAssigned                 Lead[]                    @relation("LeadAssignedTo")
  docusignEnvelopesSent         DocusignEnvelope[]        @relation("DocusignEnvelopeSentBy")
  careRecipientsCreated         CareRecipient[]           @relation("CareRecipientCreatedBy")
  careRecipientAssignments      CareRecipientAssignment[] @relation("CareRecipientAssignmentCaregiver")
  careRecipientAssignmentsGiven CareRecipientAssignment[] @relation("CareRecipientAssignmentAssignedBy")
  careInstructionsCreated       CareInstruction[]         @relation("CareInstructionCreatedBy")
  clientContactsCreated         ClientContact[]           @relation("ClientContactCreatedBy")
  clientOwnersCreated           ClientOwner[]             @relation("ClientOwnerCreatedBy")
  clientAgreementsCreated       ClientAgreement[]         @relation("ClientAgreementCreatedBy")
  clientLicensesCreated         ClientLicense[]           @relation("ClientLicenseCreatedBy")

  @@map("users")
}

// A user's saved Wise payout account. `fields` holds whatever Wise's
// dynamic /account-requirements schema asked for that currency (routing +
// account number for USD, IFSC for INR, IBAN for PKR, etc.) — we don't
// hardcode a field set per country since Wise's own requirements are the
// source of truth and shift over time. `wiseAccountId` is the recipient
// account id Wise returned when we registered it; transfers are created
// against that id, not the raw fields, so this stays a thin cache.
model WiseRecipient {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  currency          String
  accountHolderName String
  legalType         String
  wiseAccountId     String
  fields            Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("wise_recipients")
}

// One row per payout attempt through Wise — kept even when a transfer fails
// partway (status reflects how far it got) so a re-pay attempt for the same
// period is a deliberate admin action, not something that silently double-pays.
model WiseTransaction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("WiseTransactionPayee", fields: [userId], references: [id])
  initiatedById  String
  initiatedBy    User     @relation("WiseTransactionInitiatedBy", fields: [initiatedById], references: [id])
  periodFrom     DateTime
  periodTo       DateTime
  hours          Float
  sourceCurrency String
  sourceAmount   Float
  targetCurrency String
  targetAmount   Float
  wiseQuoteId    String
  wiseTransferId String?
  status         String
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("wise_transactions")
}

// One row per clock-in/clock-out session. `clockOut` stays null while the
// user is on the clock — that's how we find "currently active" sessions and
// how we stop a second clock-in from stacking on top of an open one.
model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  clockIn   DateTime
  clockOut  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Which recipient this visit was for — Caregiver clock-ins only, always
  // null for every other role's sessions. Optional even for a Caregiver: a
  // clock-in with zero recipient assignments (office work) still works.
  careRecipient   CareRecipient? @relation(fields: [careRecipientId], references: [id])
  careRecipientId String?

  // GPS captured at the moment of each action — record-only, never blocks a
  // clock-in/out. A null error alongside null coordinates just means this
  // session predates this feature or isn't a Caregiver session; a non-null
  // error ("denied" | "unavailable" | "timeout") means location was actually
  // attempted and failed, distinct from "never asked".
  clockInLatitude          Float?
  clockInLongitude         Float?
  clockInLocationAccuracy  Float?
  clockInLocationError     String?
  clockOutLatitude         Float?
  clockOutLongitude        Float?
  clockOutLocationAccuracy Float?
  clockOutLocationError    String?

  // Set once this visit is included on a Care Recipient invoice — doubles
  // as the "already billed" flag (null = unbilled, see listUnbilledVisits
  // in src/lib/actions/care-recipients.ts). SetNull rather than Cascade:
  // if the invoice that billed it is ever deleted, the visit just becomes
  // billable again instead of losing its own clock-in/out record.
  billedInvoice   Invoice? @relation(fields: [billedInvoiceId], references: [id], onDelete: SetNull)
  billedInvoiceId String?

  @@index([userId, clockIn])
  @@index([careRecipientId])
  @@map("time_entries")
}

// One row per break, paired with a Start break/End break action that mirrors
// clockIn/clockOut. Starting a break closes the caller's open TimeEntry (the
// break is unpaid, same as any other gap between sessions already is) and
// opens this row; ending it closes this row and opens a fresh TimeEntry to
// resume work. `breakEnd` stays null while the break is in progress — the
// same pattern TimeEntry uses for "currently clocked in" — which is how we
// answer "is this user on a break right now".
model BreakEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  breakStart DateTime
  breakEnd   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, breakStart])
  @@map("break_entries")
}

// An unpaid-break policy applied retroactively to hours already worked —
// e.g. a forgotten lunch-break deduction added for a whole pay period after
// the fact. Applied per calendar day (see summarizeByUser in
// src/lib/time-entries.ts): any day within [fromDate, toDate] that has
// worked hours for the targeted user(s) has minutesPerDay subtracted from
// that day's total, not once for the whole range. userId null means "every
// user's hours in range" (a company-wide policy) rather than one employee;
// multiple overlapping rules (e.g. a blanket one plus a specific one) stack.
model TimesheetBreakDeduction {
  id            String   @id @default(cuid())
  user          User?    @relation("TimesheetBreakDeductionUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  fromDate      DateTime
  toDate        DateTime
  minutesPerDay Int
  note          String?
  createdBy     User     @relation("TimesheetBreakDeductionCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("timesheet_break_deductions")
}

// A Project is an internal engagement/case grouping — independent of which
// company owns the client facilities inside it (e.g. a batch of renewals
// being worked together), not a customer account.
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdBy   User     @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Fills the project tag pill on the Clients list (docs/pipeline-stage-plan.md).
  // Nullable — unmapped projects fall back to a neutral default in the UI
  // rather than a hardcoded color per project.
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId String?

  clients Client[]

  @@map("projects")
}

// Admin-managed lookup for the Clients-list project pill color (same pattern
// as LicenseTypeTemplate/CaseType). `textColor` pairs with `hex` since some
// service colors need dark text (Ace Home Care Franchise's yellow) and
// others need white — never assumed from the background alone.
model ServiceType {
  id          String   @id @default(cuid())
  name        String   @unique
  hex         String
  textColor   String
  active      Boolean  @default(true)
  createdBy   User     @relation("ServiceTypeCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@map("service_types")
}

// Where a client stands in the engagement lifecycle — separate from `active`
// below, which only means "archived or not" (a Completed or On Hold client
// is still active, just not currently being worked). Default is Prospect:
// a brand-new client record starts as a lead, not already engaged.
enum ClientStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Client {
  id          String       @id @default(cuid())
  // A client can be worked under more than one project (e.g. a facility
  // that comes back for a new batch of renewals next year) — many-to-many
  // rather than a single owning project, so it's added once and linked
  // wherever it's relevant instead of duplicated.
  projects    Project[]
  name        String
  contactInfo String?
  address     String?
  active      Boolean      @default(true)
  status      ClientStatus @default(PROSPECT)

  // Business details — the licensed entity itself.
  businessName  String?
  businessPhone String?
  businessEmail String?

  // Structured billing address — separate from the freeform `address`
  // above because Stripe Tax needs discrete fields (state/postal code at
  // minimum for US nexus) to determine the tax jurisdiction on an invoice.
  // Required before sending an invoice with automatic tax (see
  // sendInvoice in src/lib/actions/invoices.ts).
  billingAddressLine1 String?
  billingCity         String?
  billingState        String?
  billingPostalCode   String?
  billingCountry      String? @default("US")

  // Cached Stripe Customer id (see src/lib/stripe.ts) — created on first
  // invoice send, reused after.
  stripeCustomerId String?

  createdBy   User     @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Which ClientGroup (if any) this client rolls up into on the Invoices
  // page's "By client" view — e.g. several separate Client records for the
  // same holding company/franchise that should show as one section instead
  // of several. Purely a display/grouping concern, doesn't touch billing.
  clientGroup   ClientGroup? @relation(fields: [clientGroupId], references: [id], onDelete: SetNull)
  clientGroupId String?

  applications    Application[]
  notes           Note[]
  mcoCredentials  McoCredential[]
  credentials     ClientCredential[]
  invoices        Invoice[]
  formSubmissions FormSubmission[]
  leads           Lead[]
  careRecipients  CareRecipient[]
  contacts        ClientContact[]
  owners          ClientOwner[]
  agreements      ClientAgreement[]
  licenses        ClientLicense[]
  files           FileAsset[]

  @@index([clientGroupId])
  @@map("clients")
}

// A labeled contact at the client — a partner, office manager, whoever else
// is involved in communication besides the primary owner(s) below. Deliberately
// separate from ClientOwner: a contact doesn't imply any ownership stake.
model ClientContact {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  name        String
  role        String?
  email       String?
  phone       String?
  createdBy   User     @relation("ClientContactCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@map("client_contacts")
}

// Replaces the old single ownerName/ownerEmail/ownerPhone/ownerDateOfBirth
// fields on Client — some companies have two or three owners/partners, not
// one. ownershipPercentage is informational only, nothing sums/validates it
// to 100 (real-world data is often partial or unknown).
model ClientOwner {
  id                  String   @id @default(cuid())
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId            String
  name                String
  email               String?
  phone               String?
  ownershipPercentage Float?
  createdBy           User     @relation("ClientOwnerCreatedBy", fields: [createdById], references: [id])
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([clientId])
  @@map("client_owners")
}

// Full agreement history, not just the current one — a renewal adds a new
// row rather than overwriting the last engagement's record.
model ClientAgreement {
  id            String    @id @default(cuid())
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  agreementType String
  signedDate    DateTime?
  amount        Float?
  // Plain string, not a Prisma enum — a small closed set ("Unpaid" |
  // "Partial" | "Paid") with no cross-entity filtering need, same call as
  // CareRecipient.preferredContactMethod earlier this session.
  paymentStatus String?
  notes         String?
  createdBy     User      @relation("ClientAgreementCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  docusignEnvelopes DocusignEnvelope[]

  @@index([clientId])
  @@map("client_agreements")
}

// Distinct from ClientCredential (portal login credentials) — this tracks
// the actual licenses/certifications/insurance a client holds, with expiry
// dates that feed both the dashboard alerts and the daily digest email
// (see src/lib/aging-alerts.ts, src/lib/due-date-digest.ts).
model ClientLicense {
  id            String    @id @default(cuid())
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  licenseType   String
  licenseNumber String?
  issuedDate    DateTime?
  expiryDate    DateTime
  status        String?
  createdBy     User      @relation("ClientLicenseCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([expiryDate])
  @@map("client_licenses")
}

// A person a Caregiver actually visits and gives hands-on care to — not the
// same thing as Client above (the licensed business/facility, e.g. a Home
// Care agency). Optionally tied to the agency Client they're served under,
// so an agency's page can list its own recipients, but standing up a
// recipient never requires picking one.
model CareRecipient {
  id          String    @id @default(cuid())
  name        String
  address     String?
  dateOfBirth DateTime?
  // Optional, printed masked (last 4 digits only) on a Care Recipient
  // invoice — see generateCareRecipientInvoicePdf. Plain storage, no
  // encryption at rest, same trade-off already made for
  // ClientCredential.password.
  socialSecurityNumber String?
  active               Boolean   @default(true)

  // The recipient's own reachability — distinct from emergencyContact*
  // below (a different person). preferredContactMethod and contactNotes
  // are both plain freeform strings, not enums: neither drives any
  // filtering/business logic, just a hint on this record for staff and
  // the assigned Caregiver to read.
  phone                  String?
  email                  String?
  preferredContactMethod String?
  contactNotes           String?

  // Deliberately separate from the licensing Client's own emergency-type
  // fields — this is who to call about the recipient, not about the
  // business.
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // What a caregiver should know before a visit — conditions, allergies,
  // mobility needs. Kept distinct from CareInstruction (below): this is
  // background a caregiver reads once, instructions are concrete
  // to-dos they check off.
  careNotes String?

  // Freeform, informational only — "Mon/Wed/Fri mornings" — not tied to any
  // actual scheduling/calendar logic.
  visitSchedule String?

  // Private-pay hourly rate for this recipient's care — used to auto-price
  // logged visits when billing them (see listUnbilledVisits in
  // src/lib/actions/care-recipients.ts and CreateRecipientInvoiceDialog).
  // Optional: a recipient never billed by the hour just never sets one.
  hourlyRate Float?

  // Flat per-day rate for a live-in/day-rate billing arrangement — a
  // second, independent pricing mode alongside hourlyRate above. Used to
  // auto-price a day-rate range on a Care Recipient invoice (see
  // createCareRecipientInvoice). A recipient can have either, both, or
  // neither set.
  dailyRate Float?

  // Who actually pays for their care, if different from the recipient
  // themselves — often an adult child or POA. Deliberately separate from
  // emergencyContact* above (who to call about them) and from phone/email
  // above (their own reachability) — this is specifically who an invoice
  // should be addressed/emailed to. Invoice.careRecipientId reads these at
  // send/PDF time (see resolveRecipientEmail in src/lib/actions/invoices.ts
  // and the Bill To block in src/lib/invoice-pdf.ts); left blank, an
  // invoice just bills the recipient's own name/email instead.
  billingContactName  String?
  billingContactEmail String?
  billingContactPhone String?

  // Geocoded from `address` (see src/lib/geocoding.ts) whenever it's set or
  // changed — best-effort, never blocks a create/update if it fails. Lets
  // a Caregiver's clock-in compare their own GPS against this instead of
  // just recording a raw pin with nothing to judge it against.
  latitude   Float?
  longitude  Float?
  geocodedAt DateTime?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  createdBy   User     @relation("CareRecipientCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments  CareRecipientAssignment[]
  timeEntries  TimeEntry[]
  instructions CareInstruction[]
  // Manual invoices billed for this recipient's care — see
  // Invoice.careRecipientId. Always billed through their own `client`
  // above (Invoice.clientId is a hard requirement, unrelated to this).
  invoices     Invoice[]

  @@index([clientId])
  @@map("care_recipients")
}

// A specific request for whoever visits this recipient — "Give medication
// at 2pm", "Help with laundry on Fridays" — distinct from careNotes above
// (background to read once) and from the licensing Task model (tied to
// Applications/checklists, nothing to do with a care visit). Plain
// standing checklist, not per-visit: `completed` isn't reset on a new
// clock-in — an admin/staff or the assigned Caregiver toggles it directly.
model CareInstruction {
  id              String        @id @default(cuid())
  careRecipient   CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)
  careRecipientId String
  label           String
  completed       Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdBy       User          @relation("CareInstructionCreatedBy", fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([careRecipientId])
  @@map("care_instructions")
}

// Many-to-many: a recipient can have more than one caregiver on rotation, a
// caregiver can serve more than one recipient. Same shape as
// TaskAssignee/AccessGrant elsewhere in this schema.
model CareRecipientAssignment {
  id              String        @id @default(cuid())
  careRecipient   CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)
  careRecipientId String
  caregiver       User          @relation("CareRecipientAssignmentCaregiver", fields: [caregiverId], references: [id])
  caregiverId     String
  assignedBy      User          @relation("CareRecipientAssignmentAssignedBy", fields: [assignedById], references: [id])
  assignedById    String
  assignedAt      DateTime      @default(now())

  @@unique([careRecipientId, caregiverId])
  @@index([caregiverId])
  @@map("care_recipient_assignments")
}

// A named bundle of Clients that should be treated as one section on the
// Invoices page's "By client" grouping — see Client.clientGroup above.
// Deleting a group never deletes or blocks on its clients; they just
// revert to showing individually (onDelete: SetNull on Client.clientGroup).
model ClientGroup {
  id          String   @id @default(cuid())
  name        String
  createdBy   User     @relation("ClientGroupCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  clients Client[]

  @@map("client_groups")
}

// What kind of license this Application is for (CILA, IDPH, IDOA, ...).
// Optional on Application — some Case Types (Change of Ownership) aren't
// tied to a license type at all.
model LicenseTypeTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdBy   User     @relation("LicenseTypeTemplateCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications           Application[]
  checklistItemTemplates ChecklistItemTemplate[]
  documentTemplates      DocumentTemplate[]

  @@map("license_type_templates")
}

// What kind of case this is (New, Renewal, Post-License/Ongoing, Change of
// Ownership, ...) — orthogonal to license type, drives which checklist
// template applies.
model CaseType {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdBy   User     @relation("CaseTypeCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications           Application[]
  checklistItemTemplates ChecklistItemTemplate[]

  @@map("case_types")
}

// A required checklist step for a given (LicenseTypeTemplate, CaseType)
// combo. Cloned into real Task rows when an Application is created with a
// matching combo. `phaseName` groups items into a Phase — leave null for
// flat/simple checklists (the common case).
model ChecklistItemTemplate {
  id                    String               @id @default(cuid())
  licenseTypeTemplate   LicenseTypeTemplate? @relation(fields: [licenseTypeTemplateId], references: [id])
  licenseTypeTemplateId String?
  caseType              CaseType             @relation(fields: [caseTypeId], references: [id])
  caseTypeId            String
  label                 String
  description           String?
  defaultRole           Role?
  phaseName             String?
  sortOrder             Int                  @default(0)
  createdBy             User                 @relation("ChecklistItemTemplateCreatedBy", fields: [createdById], references: [id])
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("checklist_item_templates")
}

// One stage in a pipeline's ordered stage list (see docs/pipeline-stage-plan.md).
// `sortOrder` — not `abbrev` — drives display order everywhere; abbreviations
// are unique only within a pipeline and would sort alphabetically on their
// own, scrambling the real process sequence.
// `isExitStatus` stages (On Hold, Withdrawn, Hearing Lost) are reachable from
// any other stage in the same pipeline, bypassing the forward-only rule.
// `allowedBackwardStageIds` is the explicit whitelist of stage ids this stage
// may move backward to (e.g. Corrections Received -> Submitted) — every other
// backward move is rejected. Names are locked after launch; renaming an
// existing row (rather than adding a new one) orphans historical records, so
// treat edits here as an admin-gated action, not a free-form CRUD form.
model PipelineStage {
  id                      String   @id @default(cuid())
  pipeline                Pipeline
  abbrev                  String
  name                    String
  sortOrder               Int
  hex                     String
  colorLabel              String
  isExitStatus            Boolean  @default(false)
  requiresReason          Boolean  @default(false)
  requiresFollowUpDate    Boolean  @default(false)
  allowedBackwardStageIds String[] @default([])
  active                  Boolean  @default(true)
  createdBy               User     @relation("PipelineStageCreatedBy", fields: [createdById], references: [id])
  createdById             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  applications   Application[]
  mcoCredentials McoCredential[]
  stageHistory   StageHistory[]

  @@unique([pipeline, abbrev])
  @@index([pipeline, sortOrder])
  @@map("pipeline_stages")
}

// Phase 1 scope: bare case record. Phase 2 adds license/case type +
// checklist clone-on-create — those two FKs stay optional so existing
// Applications created before this migration keep working unchanged.
model Application {
  id          String            @id @default(cuid())
  client      Client            @relation(fields: [clientId], references: [id])
  clientId    String
  name        String
  description String?
  // Superseded by pipeline/stageId (docs/pipeline-stage-plan.md) — kept
  // read-only for one release after the backfill so nothing that still
  // references it breaks mid-rollout, then dropped.
  status      ApplicationStatus @default(DRAFT)
  active      Boolean           @default(true)

  // Which stage list this case moves through and where it currently sits.
  // Nullable until the backfill script runs; required after.
  pipeline Pipeline?
  stage    PipelineStage? @relation(fields: [stageId], references: [id])
  stageId  String?

  licenseTypeTemplate   LicenseTypeTemplate? @relation(fields: [licenseTypeTemplateId], references: [id])
  licenseTypeTemplateId String?
  caseType              CaseType?            @relation(fields: [caseTypeId], references: [id])
  caseTypeId            String?

  // "Assigned VA" in the UI — the field/relation name predates the pipeline
  // spec's terminology, left as-is rather than churning every call site for
  // a label change.
  assignedUser      User    @relation("ApplicationOwner", fields: [assignedUserId], references: [id])
  assignedUserId    String
  assignedManager   User?   @relation("ApplicationManager", fields: [assignedManagerId], references: [id])
  assignedManagerId String?

  // Case-tracking fields from docs/pipeline-stage-plan.md — all optional,
  // meaningful mainly for cases actively moving through a pipeline.
  agency                          Agency?
  ballIsWith                      BallWith?
  correctionRound                 Int?
  deficiencyReceivedDate          DateTime?
  deficiencyResponseDueDate       DateTime?
  deficiencyResponseSubmittedDate DateTime?

  createdBy   User     @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases             Phase[]
  tasks              Task[]
  accessGrants       AccessGrant[]
  files              FileAsset[]
  generatedDocuments GeneratedDocument[]
  notes              Note[]
  stageHistory       StageHistory[]
  invoices           Invoice[]
  docusignEnvelopes  DocusignEnvelope[]

  @@map("applications")
}

// One row per stage change on an Application — the source of truth for
// "days in current stage" (now - latest row's enteredAt) and per-stage
// duration reporting. Never updated or deleted, only appended to, so history
// never shrinks even as a case moves back and forth.
// Polymorphic the same way Note is (exactly one of applicationId/
// mcoCredentialId set) — an MCO credential moves through the MCO pipeline
// independently of any Application, but needs the exact same "timestamp
// every stage change" history for its own days-in-stage/aging alerts.
model StageHistory {
  id              String         @id @default(cuid())
  application     Application?   @relation(fields: [applicationId], references: [id])
  applicationId   String?
  mcoCredential   McoCredential? @relation(fields: [mcoCredentialId], references: [id])
  mcoCredentialId String?
  stage           PipelineStage  @relation(fields: [stageId], references: [id])
  stageId         String
  // Set when the stage entered requires them (On Hold needs both, Withdrawn
  // needs reason) — belongs to this specific transition, not the case as a
  // whole, so it lives here rather than on Application/McoCredential.
  reason          String?
  followUpDate    DateTime?
  enteredAt       DateTime       @default(now())
  actor           User           @relation("StageHistoryActor", fields: [actorId], references: [id])
  actorId         String

  @@index([applicationId, enteredAt])
  @@index([mcoCredentialId, enteredAt])
  @@map("stage_history")
}

// One row per client per MCO — never one per client (a client credentialing
// with five MCOs has five records, each moving through the MCO pipeline
// independently). Client profile renders these side by side.
model McoCredential {
  id       String  @id @default(cuid())
  client   Client  @relation(fields: [clientId], references: [id])
  clientId String
  mcoName  McoName

  stage   PipelineStage? @relation(fields: [stageId], references: [id])
  stageId String?

  npi                    String?
  providerId             String?
  effectiveDate          DateTime?
  recredentialingDueDate DateTime?

  ballIsWith                      BallWith?
  correctionRound                 Int?
  deficiencyReceivedDate          DateTime?
  deficiencyResponseDueDate       DateTime?
  deficiencyResponseSubmittedDate DateTime?

  assignedUser      User?   @relation("McoCredentialAssignee", fields: [assignedUserId], references: [id])
  assignedUserId    String?
  assignedManager   User?   @relation("McoCredentialManager", fields: [assignedManagerId], references: [id])
  assignedManagerId String?

  createdBy   User     @relation("McoCredentialCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stageHistory StageHistory[]

  @@unique([clientId, mcoName])
  @@map("mco_credentials")
}

// Shares an Application with a user beyond its owner/assignee — e.g. a
// colleague covering while the owner is out, or (Phase 5) a Client portal
// user. VIEW sees the case; EDIT can also change tasks/properties/files.
model AccessGrant {
  id            String          @id @default(cuid())
  application   Application     @relation(fields: [applicationId], references: [id])
  applicationId String
  user          User            @relation("AccessGrantUser", fields: [userId], references: [id])
  userId        String
  permission    GrantPermission @default(VIEW)
  grantedBy     User            @relation("AccessGrantGrantedBy", fields: [grantedById], references: [id])
  grantedById   String
  createdAt     DateTime        @default(now())

  @@unique([applicationId, userId])
  @@map("access_grants")
}

// Two pools: the shared Application pool (applicationId set, taskId null —
// every user with case access sees these) and per-task attachments (taskId
// set, scoped to that one task/subtask, including standalone tasks where
// applicationId is null).
// fileName/mimeType/sizeBytes mirror the latest FileVersion so list queries
// don't need to join versions just to show current metadata.
model FileAsset {
  id            String       @id @default(cuid())
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  task          Task?        @relation(fields: [taskId], references: [id])
  taskId        String?
  // Third parent kind, alongside applicationId/taskId above — the "one
  // stop shop" ask: a signed agreement, EIN letter, W-9, license, or
  // insurance certificate attached directly to the client, not routed
  // through a case or task.
  client        Client?      @relation(fields: [clientId], references: [id])
  clientId      String?
  fileName      String
  storageKey    String
  mimeType      String
  sizeBytes     Int
  uploadedBy    User         @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  uploadedById  String
  createdAt     DateTime     @default(now())

  versions            FileVersion[]
  signatureEvents     SignatureEvent[]
  envelopesAsSource   DocusignEnvelope[] @relation("EnvelopeSourceFile")
  envelopeAsCompleted DocusignEnvelope?  @relation("EnvelopeCompletedFile")

  @@map("file_assets")
}

// One GCS generation of a FileAsset's object (same storageKey, overwritten
// in place — the bucket has Object Versioning on, so every generation is
// still retrievable). Uploading a new version or reverting both append a
// new row here rather than deleting anything, so history never shrinks.
// Files with any SignatureEvent are excluded from new versions/reverts
// (see assertNotSigned in files.ts) — a signed PDF's bytes must stay fixed.
model FileVersion {
  id           String    @id @default(cuid())
  fileAsset    FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  fileAssetId  String
  version      Int
  generation   BigInt
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedBy   User      @relation("FileVersionUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime  @default(now())

  @@unique([fileAssetId, version])
  @@map("file_versions")
}

// An uploaded merge-tag .docx (handbook, policy, etc.) admins manage. Scoped
// to a license type when it only applies to that kind of case; null means it
// shows up as an option for every Application.
model DocumentTemplate {
  id                    String               @id @default(cuid())
  name                  String
  description           String?
  licenseTypeTemplate   LicenseTypeTemplate? @relation(fields: [licenseTypeTemplateId], references: [id])
  licenseTypeTemplateId String?
  storageKey            String
  fileName              String
  active                Boolean              @default(true)
  createdBy             User                 @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id])
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  fields             DocumentTemplateField[]
  generatedDocuments GeneratedDocument[]

  @@map("document_templates")
}

// One merge tag found in the template's .docx body. AUTO fields resolve from
// Client/Application data at generation time (see src/lib/merge-fields.ts for
// the fixed registry); CUSTOM fields prompt the VA for a value per generation.
model DocumentTemplateField {
  id         String           @id @default(cuid())
  template   DocumentTemplate @relation(fields: [templateId], references: [id])
  templateId String
  key        String
  label      String
  source     FieldSource      @default(CUSTOM)
  autoField  String?
  sortOrder  Int              @default(0)

  @@unique([templateId, key])
  @@map("document_template_fields")
}

// One merged-and-generated document for an Application. `fieldValues` is a
// snapshot of the values used at generation time, kept for audit/reference —
// regenerating creates a new row rather than overwriting this one.
model GeneratedDocument {
  id            String                  @id @default(cuid())
  template      DocumentTemplate        @relation(fields: [templateId], references: [id])
  templateId    String
  application   Application             @relation(fields: [applicationId], references: [id])
  applicationId String
  fileName      String
  storageKey    String
  status        GeneratedDocumentStatus @default(DRAFT)
  fieldValues   Json
  generatedBy   User                    @relation("GeneratedDocumentGeneratedBy", fields: [generatedById], references: [id])
  generatedById String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("generated_documents")
}

// Optional ordered grouping of Tasks within an Application (e.g. "Phase 1",
// "Phase 2" for CILA post-license). Most Applications have none — Tasks with
// no Phase just render as a flat list.
model Phase {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  name          String
  sortOrder     Int         @default(0)

  tasks Task[]

  @@map("phases")
}

// A checklist item / task. `applicationId` is null for standalone/recurring
// ops tasks not tied to any case. `parentTaskId` set = this is a subtask.
model Task {
  id            String       @id @default(cuid())
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  phase         Phase?       @relation(fields: [phaseId], references: [id])
  phaseId       String?
  // Set only for a follow-up task auto-created by changeLeadStage
  // (src/lib/actions/leads.ts) on a NO_SHOW/MISSED transition — purely
  // informational (lets the Leads inbox show/link it), not an access
  // boundary: this is a standalone task like any other with no
  // applicationId, so assertCanAccessTask's existing
  // assignee/creator/ADMIN/MANAGER fallback already covers it unchanged.
  lead          Lead?        @relation(fields: [leadId], references: [id])
  leadId        String?

  checklistItemTemplateId String?

  label       String
  description String?
  status      TaskStatus @default(NOT_STARTED)
  sortOrder   Int        @default(0)

  dueDate        DateTime?
  blockedReason  String?
  recurrenceRule String?
  archived       Boolean   @default(false)

  // Budget line for the Everhour-style time tracker (TaskTimeEntry below) —
  // null means no budget set, the weekly grid/task detail just show tracked
  // hours with no comparison bar. Purely a display/alert threshold, nothing
  // blocks logging time past it.
  estimatedHours Float?

  assignees TaskAssignee[]
  reviewers TaskReviewer[]

  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  parentTaskId String?
  subtasks     Task[]  @relation("TaskSubtasks")

  createdBy   User     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes           Note[]
  files           FileAsset[]
  taskTimeEntries TaskTimeEntry[]

  @@map("tasks")
}

enum TaskTimeEntrySource {
  TIMER
  MANUAL
}

// Everhour-style work time tracking, layered on top of (not replacing) the
// attendance clock above (TimeEntry/BreakEntry) — that's one shift per user
// for payroll; this is time logged against a specific Task, for case-level
// reporting and client billing. taskId null is the "Internal/no task"
// bucket for work that isn't tied to any case.
model TaskTimeEntry {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  task   Task?   @relation(fields: [taskId], references: [id])
  taskId String?

  startedAt   DateTime
  // Null = still running — the one open timer for this user (startTimer in
  // src/lib/actions/task-time-entries.ts closes any other open entry of
  // theirs before starting a new one). Manual entries always have both set.
  endedAt     DateTime?
  description String?
  // Whether this time should ever be eligible for "bill tracked time" on an
  // invoice — off for e.g. internal/admin work that shouldn't reach a
  // client bill. Doesn't affect payroll (User.hourlyRate is used either way
  // for the $ shown in reports).
  billable    Boolean             @default(true)
  source      TaskTimeEntrySource @default(MANUAL)

  // Same shape/reasoning as TimeEntry.billedInvoiceId — set once rolled
  // into an invoice line item; SetNull so deleting that invoice un-bills
  // the entry instead of losing it.
  billedInvoice   Invoice? @relation(fields: [billedInvoiceId], references: [id], onDelete: SetNull)
  billedInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([taskId])
  @@map("task_time_entries")
}

model TaskAssignee {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([taskId, userId])
  @@map("task_assignees")
}

model TaskReviewer {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([taskId, userId])
  @@map("task_reviewers")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String?
  oldValue   String?
  newValue   String?
  action     String
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// User's saved signature image, drawn/typed/uploaded once and reused across
// documents — applying it to a specific document is still an explicit
// per-signing action (SignatureEvent), so accountability stays per-event.
model SignatureProfile {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String   @unique
  signatureImageKey String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("signature_profiles")
}

// A signature flattened onto a specific FileAsset (the resulting signed PDF).
// Position stored as ratios of page size so it's independent of any one
// viewer's pixel scale.
//
// RETIRED as of the DocusignEnvelope model below — new signing goes through
// DocuSign, not this in-app self-sign flow. Left completely unchanged, not
// deleted: existing rows and the FileAssets they point at are read-only
// history (a document someone already signed this way stays exactly as
// signed), and no new code creates a new row here. Same for SignatureProfile
// above — DocuSign captures the signer's actual signature during its own
// hosted ceremony, so there's no "pre-saved drawn signature" concept in the
// new flow at all.
model SignatureEvent {
  id          String    @id @default(cuid())
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id])
  fileAssetId String
  signedBy    User      @relation("SignatureEventSignedBy", fields: [signedById], references: [id])
  signedById  String
  pageNumber  Int
  xRatio      Float
  yRatio      Float
  widthRatio  Float
  heightRatio Float
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@map("signature_events")
}

enum DocusignEnvelopeStatus {
  CREATED
  SENT
  DELIVERED // DocuSign's "viewed" — matches their own envelope-status vocabulary
  COMPLETED
  DECLINED
  VOIDED // includes DocuSign's own auto-void-on-expiration case
}

// One DocuSign envelope sent from inside HCLM — replaces SignatureEvent/
// SignatureProfile above as the one signing flow going forward. Exactly one
// of applicationId/clientAgreementId is set, enforced in the action layer
// (src/lib/actions/docusign-envelopes.ts), not a DB constraint — same "no
// XOR CHECK constraint" convention FileAsset itself already uses for its
// own applicationId/taskId/clientId.
//
// No stored EXPIRED status: DocuSign itself has no such status — an
// unsigned envelope past its expiresAt transitions to VOIDED with a reason.
// "Expiring soon" is derived at read time against expiresAt (status in
// SENT/DELIVERED, expiresAt close), same convention as ClientLicense/
// computeLicenseAlerts (src/lib/aging-alerts.ts) — never a separately
// tracked flag that could go stale.
model DocusignEnvelope {
  id                String           @id @default(cuid())
  application       Application?     @relation(fields: [applicationId], references: [id])
  applicationId     String?
  clientAgreement   ClientAgreement? @relation(fields: [clientAgreementId], references: [id])
  clientAgreementId String?

  // The document sent for signature.
  sourceFileAsset      FileAsset  @relation("EnvelopeSourceFile", fields: [sourceFileAssetId], references: [id])
  sourceFileAssetId    String
  // The signed result, downloaded and stored once DocuSign Connect reports
  // COMPLETED (see the webhook route) — null until then.
  completedFileAsset   FileAsset? @relation("EnvelopeCompletedFile", fields: [completedFileAssetId], references: [id])
  completedFileAssetId String?    @unique

  // DocuSign's own envelope GUID — the webhook's idempotency key.
  docusignEnvelopeId String                 @unique
  status             DocusignEnvelopeStatus @default(CREATED)

  signerName  String
  signerEmail String
  // Where the signature tab goes, as ratios of page size (same convention
  // as the retired SignatureEvent above) — top-left origin, no Y-flip
  // needed for DocuSign (unlike pdf-lib's bottom-left drawImage origin the
  // old flow used); see src/lib/docusign.ts.
  pageNumber  Int
  xRatio      Float
  yRatio      Float

  expiresAt     DateTime?
  declineReason String?
  voidReason    String?

  sentBy   User   @relation("DocusignEnvelopeSentBy", fields: [sentById], references: [id])
  sentById String

  sentAt      DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  declinedAt  DateTime?
  voidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([clientAgreementId])
  @@map("docusign_envelopes")
}

// In-app notification for events a user should know about (reassignment,
// review requests, status changes, new access grants). Pull-based — no
// background scheduler in this deployment, so everything is created inline
// by the action that causes it.
model Notification {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id])
  userId     String
  type       NotificationType
  message    String
  entityType String
  entityId   String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// Comment thread on an Application — the collaboration surface for staff
// discussing a case. @mentions are resolved client-side into explicit user
// ids (not parsed from text server-side) so notification delivery never
// depends on exact name matching.
// Exactly one of applicationId/taskId/clientId is set — Application
// comments are the case-level discussion thread, Task comments are notes on
// one checklist item or standalone task, Client comments are general notes
// on that client (not tied to any one case).
model Note {
  id            String       @id @default(cuid())
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?
  task          Task?        @relation(fields: [taskId], references: [id])
  taskId        String?
  client        Client?      @relation(fields: [clientId], references: [id])
  clientId      String?
  body          String
  author        User         @relation("NoteAuthor", fields: [authorId], references: [id])
  authorId      String
  createdAt     DateTime     @default(now())

  @@map("notes")
}

// Portal/agency login credentials for a client, kept as their own structured
// section rather than typed into the Notes thread — the whole point being
// they don't get buried under a growing comment feed (per the spec: "so
// that when the manager or VA adds notes, the login credentials ... will
// not get buried or overlooked"). Stored as plain fields, same visibility
// as the rest of a Client record — not encrypted at rest.
model ClientCredential {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  label       String
  username    String?
  password    String?
  url         String?
  notes       String?
  createdBy   User     @relation("ClientCredentialCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_credentials")
}

// One invoice sent to a Client, optionally tied back to the Application it
// was billed for. `seq` is a plain autoincrement used only to render a
// stable display number ("INV-00042") — there's no separate unique string
// column to keep in sync or race on. `total` is always server-recomputed
// from lineItems + taxAmount, never trusted from the client.
model Invoice {
  id            String        @id @default(cuid())
  // Local draft counter — only used to display a number before Stripe
  // assigns its own (stripeInvoiceNumber, set at finalize).
  seq           Int           @default(autoincrement())
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  application   Application?  @relation(fields: [applicationId], references: [id])
  applicationId String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?
  // Free text for whoever created the invoice — their own reference (e.g.
  // "referred by Sarah", "rush job"). Unlike `notes`, never printed on the
  // PDF, never included in any invoice/receipt email, and never sent to
  // Stripe — see generateInvoicePdf/generateReceiptPdf and the send*
  // actions in src/lib/actions/invoices.ts, none of which read this field.
  internalTag   String?

  // Null until Stripe finalizes the invoice — Stripe computes the actual
  // tax (via Stripe Tax) and total at that point, not us.
  total     Float?
  taxAmount Float?

  // Set on first "Send": a Stripe Invoice + its line items are created,
  // finalized, then emailed by Stripe itself (see src/lib/stripe.ts /
  // src/lib/actions/invoices.ts). Resending reuses the same Stripe invoice.
  stripeInvoiceId     String? @unique
  stripeInvoiceNumber String?
  hostedInvoiceUrl    String?
  invoicePdfUrl       String?

  // A manually-typed number for a recordManualPayment invoice — lets it
  // match an existing paper receipt/QuickBooks number instead of showing
  // the generic DRAFT-##### placeholder (see displayInvoiceNumber in
  // src/lib/invoice-format.ts). @unique still allows any number of nulls;
  // only actual duplicate typed numbers collide.
  invoiceNumber String? @unique

  sentAt            DateTime?
  paidAt            DateTime?
  // Set only by recordManualPayment/addManualPayment — a transaction paid
  // before any invoice existed (cash/check/wire), recorded with no Stripe
  // involvement at all. stripeInvoiceId staying null on a PAID or
  // PARTIALLY_PAID row is what marks it as one of these (see
  // isManualPayment in invoice-status-badge.tsx). amountPaid is the running
  // total actually received so far — only meaningful for these rows.
  paymentMethod     String?
  amountPaid        Float?    @default(0)
  // Manual invoices only — tracks the "Send invoice PDF" button (a plain
  // courtesy copy, before payment).
  lastSentAt        DateTime?
  // Set by updateManualInvoiceDraft whenever an edit lands after lastSentAt
  // is already set — i.e. the client may be holding a PDF that no longer
  // matches this invoice. Cleared back to null the next time "Send invoice
  // PDF" actually goes out (see sendManualInvoicePdf), since that email
  // carries the current version. Drives the "edited after sending"
  // indicator on the invoice list/detail pages.
  editedAfterSendAt DateTime?
  // Set only by importStripeInvoice — a Stripe invoice created directly in
  // the Stripe Dashboard (never through this app), pulled in after the
  // fact so it shows up here too. It's just a local mirror of something
  // that already fully exists in Stripe: deleteInvoice allows removing one
  // regardless of status (unlike a normal invoice, deletable only while
  // DRAFT), since deleting it never touches the real Stripe invoice —
  // whoever imported it can safely re-import if they picked the wrong one.
  importedAt        DateTime?
  createdBy         User      @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Manual invoices only — which billing identity (logo/CC/footer) this
  // was billed under. Null forever on a Stripe-bound invoice, same as
  // stripeInvoiceId is null forever on a manual one. SetNull on delete so
  // removing a profile later can never be blocked by, or destroy, a
  // historical invoice's own record of who it billed under.
  invoiceProfile   InvoiceProfile? @relation(fields: [invoiceProfileId], references: [id], onDelete: SetNull)
  invoiceProfileId String?

  // Manual invoices only, same as invoiceProfile above — which Care
  // Recipient this invoice bills for, if any (still billed to `client`
  // above regardless; this is a tag, not a separate billing identity — see
  // CareRecipient's own comment in prisma/schema.prisma). SetNull on
  // delete so removing a recipient later can never be blocked by, or
  // destroy, a historical invoice's own record of who it billed for.
  careRecipient   CareRecipient? @relation(fields: [careRecipientId], references: [id], onDelete: SetNull)
  careRecipientId String?

  lineItems             InvoiceLineItem[]
  payments              Payment[]
  receipts              Receipt[]
  attachments           InvoiceAttachment[]
  // TimeEntry rows billed on this invoice — see TimeEntry.billedInvoiceId.
  billedTimeEntries     TimeEntry[]
  // TaskTimeEntry rows billed on this invoice — see TaskTimeEntry.billedInvoiceId.
  billedTaskTimeEntries TaskTimeEntry[]

  @@index([clientId])
  @@map("invoices")
}

// A supporting document attached to an invoice — a signed contract, a
// receipt from a third party, a photo, whatever's relevant — separate from
// the invoice's own generated PDF (invoicePdfUrl) and a payment's Receipt.
// Unlike FileAsset (Applications/Tasks), there's no versioning or signing
// here: just upload/download/delete. mimeType is validated against
// ALLOWED_ATTACHMENT_TYPES in src/lib/actions/invoice-attachments.ts at
// upload time — images, PDF, .xlsx, .docx.
model InvoiceAttachment {
  id           String   @id @default(cuid())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedBy   User     @relation("InvoiceAttachmentUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_attachments")
}

// One row per payment recorded against a manually-recorded invoice — the
// history addManualPayment used to collapse into a single running
// amountPaid total on Invoice (still kept, as the "current cumulative"
// summary shown on the invoice itself). Each Payment gets its own Receipt,
// generated the moment it's recorded — see addManualPayment in
// src/lib/actions/invoices.ts.
model Payment {
  id            String   @id @default(cuid())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  amount        Float
  paidAt        DateTime
  paymentMethod String
  recordedBy    User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  recordedById  String
  createdAt     DateTime @default(now())

  receipt Receipt?

  @@index([invoiceId])
  @@map("payments")
}

// A generated PDF documenting one Payment — created automatically the
// moment addManualPayment records that payment, but never emailed
// automatically. Sending is a separate, explicit action (sendReceiptEmail
// in src/lib/actions/invoices.ts) so staff decide per-receipt whether the
// client gets a copy; sentAt/sentTo track whether/when that happened.
model Receipt {
  id         String    @id @default(cuid())
  // Local counter for a human-readable receipt number ("R-000123", see
  // displayReceiptNumber in src/lib/invoice-format.ts) — same pattern as
  // Invoice.seq.
  seq        Int       @default(autoincrement())
  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId  String    @unique
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  storageKey String
  sentAt     DateTime?
  sentTo     String?
  createdAt  DateTime  @default(now())

  @@index([invoiceId])
  @@map("receipts")
}

// MANUAL is every line item today (a plain typed description) — VISIT_HOURLY
// and VISIT_DAILY are structured rows a Care Recipient invoice generates
// from billed visits/day-rate ranges (see createCareRecipientInvoice),
// letting generateCareRecipientInvoicePdf render real Worker/Times/Date
// columns instead of parsing them back out of `description`.
enum InvoiceLineItemKind {
  MANUAL
  VISIT_HOURLY
  VISIT_DAILY
}

model InvoiceLineItem {
  id          String              @id @default(cuid())
  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Int                 @default(1)
  unitPrice   Float
  sortOrder   Int                 @default(0)
  kind        InvoiceLineItemKind @default(MANUAL)

  // Set only when kind is VISIT_HOURLY or VISIT_DAILY — a snapshot taken
  // at billing time, not a live join, since the caregiver can be
  // reassigned/deactivated after the invoice is generated.
  visitDate  DateTime?
  visitStart DateTime?
  visitEnd   DateTime?
  workerName String?

  @@map("invoice_line_items")
}

// Org-wide branding/config applied to a manually-recorded invoice's PDF
// and emails — logo, CC recipients, and boilerplate footer text. One row
// per billing identity; exactly one has isDefault: true at any time
// (enforced in the action layer — see setDefaultInvoiceProfile in
// src/lib/actions/invoice-profiles.ts, Prisma can't express a
// conditional unique constraint declaratively). Read via
// listInvoiceProfiles()/getInvoiceProfile() in
// src/lib/invoice-profiles.ts, edited from /admin/invoice-profiles.
// Stripe-bound invoices aren't touched by this — Stripe emails those
// itself and has its own branding settings.
model InvoiceProfile {
  id        String  @id @default(cuid())
  // Shown in the picker AND printed on the PDF/emails — one field, not two.
  name      String
  isDefault Boolean @default(false)

  logoStorageKey String?
  logoMimeType   String?
  // Comma-separated email addresses, CC'd on every invoice email sent
  // under this profile.
  ccEmails       String?
  // Boilerplate printed at the bottom of every invoice PDF using this
  // profile, below the invoice's own (optional) notes — terms, remit-to
  // info, etc.
  footerText     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@map("invoice_profiles")
}

// --- Form builder / public intake forms ------------------------------------
// A public, unauthenticated surface (see isPublicPath in src/auth.config.ts)
// — the one place in the app anyone can write to without a session. Every
// submission lands as PENDING for staff to triage; nothing here ever
// creates or touches a Client on its own (see createClientFromSubmission /
// attachSubmissionToClient in src/lib/actions/form-submissions.ts).

enum FormFieldType {
  TEXT
  LONG_TEXT
  EMAIL
  PHONE
  DATE
  SELECT
  CHECKBOX
  FILE
}

enum FormSubmissionStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model FormTemplate {
  id          String  @id @default(cuid())
  name        String
  // URL-friendly and unique — the public link is /forms/{slug}, so this is
  // effectively load-bearing (share it wrong and the form 404s), not just
  // cosmetic.
  slug        String  @unique
  description String?
  active      Boolean @default(true)

  // Who gets emailed on a new submission — see submitForm in
  // src/lib/actions/public-forms.ts. Both empty falls back to every active
  // ADMIN (the original, hardcoded behavior); either one non-empty
  // replaces that default entirely, deduped against each other.
  notifyUserIds String[] @default([])
  notifyEmails  String?

  createdBy   User     @relation("FormTemplateCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields      FormField[]
  submissions FormSubmission[]

  @@map("form_templates")
}

// One field in a template. `key` is what the submitted answers JSON is
// keyed by (see FormSubmission.answers) — stable even if `label` is edited
// later. `clientField` is this field's optional mapping onto a Client
// column (e.g. "businessEmail") for pre-filling "Create client from this"
// in the review queue; left null, the answer is still shown for reference
// but never auto-filled anywhere.
model FormField {
  id          String        @id @default(cuid())
  template    FormTemplate  @relation(fields: [templateId], references: [id])
  templateId  String
  key         String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  options     String[] // SELECT only
  clientField String?
  sortOrder   Int           @default(0)

  @@unique([templateId, key])
  @@map("form_fields")
}

// Where a Lead came from — one value today (a Calendly booking), kept as
// its own enum rather than hardcoding "Calendly" everywhere so a second
// source (a "Contact us" form, a referral) doesn't force a rename later.
enum LeadSource {
  CALENDLY
}

// Booked -> Held -> Follow-up sent -> Rebooked -> Converted -> Lost. A
// plain closed enum, not a PipelineStage-style admin-configurable catalog
// like Application/MCO credentialing use (see docs/pipeline-stage-plan.md)
// — that machinery (rule engine, StageHistory, drag/drop board) solves a
// much bigger problem (3 pipelines, up to 24 stages, per-stage required
// fields) than these 6 fixed stages need. Any stage can move to any other
// stage — no backward-move whitelist, staff aren't restricted here.
enum LeadStage {
  BOOKED
  HELD
  NO_SHOW // client didn't show — see changeLeadStage in src/lib/actions/leads.ts, which auto-creates a required follow-up Task on this transition
  MISSED // CTK didn't show — same auto-follow-up-task behavior as NO_SHOW
  FOLLOW_UP_SENT
  REBOOKED
  CONVERTED
  LOST
}

// One inbound lead — today always a Calendly booking, landing here
// straight off the invitee.created webhook (see
// src/app/api/webhooks/calendly/route.ts). Mirrors FormSubmission's
// review-queue shape: `client`/`reviewedBy` stay null until staff acts on
// it (create a new Client, attach to an existing one, or mark Lost — see
// src/lib/actions/leads.ts), just with a 6-stage `stage` instead of a
// 3-value `status`.
model Lead {
  id     String     @id @default(cuid())
  source LeadSource @default(CALENDLY)
  stage  LeadStage  @default(BOOKED)

  // Invitee details, straight from Calendly's invitee.created payload.
  inviteeName  String
  inviteeEmail String
  // Calendly doesn't put a phone field on the invitee resource by default
  // — this is extracted from questions_and_answers (or text_reminder_number
  // when SMS reminders are configured), see extractPhoneAnswer in
  // src/lib/calendly.ts. Null when neither is present.
  inviteePhone String?
  timezone     String?

  // The scheduled event, not the invitee — start/end/location come from
  // the payload's embedded scheduled_event object.
  meetingStartAt DateTime
  meetingEndAt   DateTime?
  // scheduled_event.location.join_url — populated only when Calendly's own
  // Zoom conferencing was used for this booking. Covers the separate
  // "Zoom integration" backlog item for free: no Zoom API call needed.
  meetingJoinUrl String?

  // Calendly's own identifiers. calendlyInviteeUri is the real idempotency
  // key (one row per invitee); calendlyEventUri is indexed but not unique
  // since a group event type could have more than one invitee per event.
  calendlyEventUri   String
  calendlyInviteeUri String @unique

  // Calendly's questions_and_answers array, stored verbatim — same
  // convention as FormSubmission.answers.
  answers Json

  // Set by the invitee.canceled webhook. Deliberately doesn't auto-move
  // `stage` to LOST — a canceled booking might get rebooked (that's what
  // the REBOOKED stage is for), so the system just surfaces the fact and
  // lets staff decide what it means.
  canceledAt   DateTime?
  cancelReason String?

  client       Client?   @relation(fields: [clientId], references: [id])
  clientId     String?
  reviewedBy   User?     @relation("LeadReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  // Who follows up on this booking — backlog item 15 ("Assignment") for the
  // Lead half of it; the other half (DocuSign envelopes) has nothing to own
  // yet, since DocuSign isn't built. Drives who gets the meeting-reminder
  // notify()/Teams post — see src/lib/meeting-reminders.ts.
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?

  // Set once each reminder actually fires (src/lib/meeting-reminders.ts) —
  // a threshold check against these, not a narrow time-window match, so a
  // process restart between polls still catches up instead of silently
  // skipping a lead. Doesn't matter whether every channel (Teams/SMS) that
  // tick actually succeeded — see the "degrade gracefully" note there.
  reminder24hSentAt DateTime?
  reminder30mSentAt DateTime?

  // The auto-created follow-up task on a NO_SHOW/MISSED transition (see
  // Task.leadId above) — usually 0 or 1, not a general task list for the lead.
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([calendlyEventUri])
  @@map("leads")
}

// One filled-out form. `ipAddress` is spam triage only — deliberately never
// surfaced as "who submitted this" anywhere in the UI, since it identifies
// a request, not a person. `client`/`reviewedBy` stay null until staff acts
// on it (see PENDING in FormSubmissionStatus).
model FormSubmission {
  id           String               @id @default(cuid())
  template     FormTemplate         @relation(fields: [templateId], references: [id])
  templateId   String
  answers      Json
  status       FormSubmissionStatus @default(PENDING)
  client       Client?              @relation(fields: [clientId], references: [id])
  clientId     String?
  reviewedBy   User?                @relation("FormSubmissionReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  ipAddress    String?
  createdAt    DateTime             @default(now())

  files FormSubmissionFile[]

  @@map("form_submissions")
}

// A FILE-type field's upload — stored the same way every other upload in
// the app is (saveUploadedFile in src/lib/storage.ts, virus-scanned before
// it ever reaches GCS), just referenced from a submission instead of a
// Task/Application/Invoice.
model FormSubmissionFile {
  id           String         @id @default(cuid())
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  fieldKey     String
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  @@map("form_submission_files")
}
