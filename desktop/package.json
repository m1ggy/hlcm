{
  "name": "carenela-desktop",
  "productName": "Carenela",
  "version": "0.3.0",
  "private": true,
  "description": "Carenela desktop app: clock in and activity monitoring for office staff",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"dist/main/*.test.js\"",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "get-windows": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.carenela.desktop",
    "productName": "Carenela",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*.js",
      "!dist/**/*.test.js",
      "src/renderer/**",
      "src/preload.js",
      "config.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Carenela-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Carenela-${version}-${arch}.${ext}",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureUsageDescription": "Carenela takes screenshots while you are clocked in, as described in the monitoring notice."
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/agent"
      }
    ]
  }
}
