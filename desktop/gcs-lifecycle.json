{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "Delete" },
        "condition": { "age": 91, "matchesPrefix": ["screenshots/"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "isLive": false, "daysSinceNoncurrentTime": 1, "matchesPrefix": ["screenshots/"] }
      }
    ]
  }
}
